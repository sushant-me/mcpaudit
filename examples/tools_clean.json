{
  "tools": [
    {
      "name": "search_docs",
      "description": "Search the product documentation for a phrase.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string"
          }
        },
        "required": [
          "query"
        ]
      },
      "annotations": {
        "readOnlyHint": true
      }
    },
    {
      "name": "get_order",
      "description": "Fetch one order by its identifier.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "order_id": {
            "type": "string",
            "pattern": "^A-[0-9]{4}$"
          }
        }
      },
      "annotations": {
        "readOnlyHint": true
      }
    }
  ]
}
